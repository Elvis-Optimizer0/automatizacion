{
  "name": "video-maker",
  "version": "1.0.0",
  "description": "Video Maker - App de escritorio para crear videos con zoom, transiciones y overlays",
  "main": "app/main.js",
  "scripts": {
    "start": "electron app/main.js",
    "test": "vitest run",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.videomaker.app",
    "productName": "Video Maker",
    "files": [
      "app/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VideoMaker-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "20.x"
  }
}