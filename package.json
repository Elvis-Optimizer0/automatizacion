{
  "name": "video-maker",
  "version": "1.2.8",
  "description": "Video Maker - App de escritorio para crear videos con zoom, transiciones y overlays",
  "main": "app/main.js",
  "author": "Elvis-Optimizer0",
  "scripts": {
    "start": "electron app/main.js",
    "test": "npm run syntax-check && vitest run",
    "test:extension": "vitest run extension/tests",
    "dist": "electron-builder --win --x64 --publish never",
    "syntax-check": "node scripts/syntax-check.js"
  },
  "build": {
    "appId": "com.videomaker.app",
    "productName": "Video Maker FIX",
    "files": [
      "app/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "app/assets/fonts/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VideoMaker-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vitest": "5.0.3",
    "jsdom": "24.0.0"
  },
  "engines": {
    "node": "20.x"
  }
}